<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads: the service that keeps the process alive while Rust fetches files, its
         notification (POST_NOTIFICATIONS on Android 13+), and whether the network they go over
         is metered (the "Download over Wi-Fi only" setting). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Casting: Android drops multicast packets unless the app holds a Wi-Fi multicast lock
         while it browses for Chromecasts (MainActivity, crates/app/src/android.rs). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Vulkan 1.0 is what wgpu prefers; GLES 3 is its fallback. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Backups: the access tokens are plain files in the app's private storage (Android has no
         keychain the app can use; crates/app/src/credentials.rs), and the config names the
         server and the user, so none of it may leave the phone. At targetSdk 36 that takes two
         settings: allowBackup="false" ends Auto Backup and `adb backup` (Android 6 to 11 too, as
         minSdk is 26), but from Android 12 device-to-device transfer follows
         dataExtractionRules instead, which excludes everything from both. -->
    <application
        android:label="Tabbyfin"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false">

        <!-- configChanges: the app redraws itself on rotation and resizes, so the activity (and
             with it the Rust app) isn't recreated: a recreated activity would end the process
             (MainActivity.onDestroy) or, if it lived, never draw (the Rust app runs once per
             process). That includes the font size, the language and the text direction. Rust
             doesn't hear of them: the app has its own text size setting and takes the system's
             language only when it applies its appearance (at launch and when Settings changes
             it), so a change of either shows the next launch, and the layout direction follows
             the app's language. The last four (touchscreen, colour mode, mobile codes, grammatical
             gender) change rarely and need nothing either. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection|touchscreen|colorMode|mcc|mnc|grammaticalGender"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="tabbyfin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Downloads: spends the process's time in the foreground, with a progress notification,
             while Rust downloads files on its own threads (the work itself is Rust's).
             stopWithTask: the downloads stop with the app, rather than carrying on unseen. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true" />
    </application>
</manifest>
